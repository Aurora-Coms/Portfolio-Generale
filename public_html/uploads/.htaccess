# =============================================================================
#  Dossier des images téléversées : AUCUNE exécution de code possible.
# =============================================================================
# Même si un fichier malveillant arrivait ici, il ne pourrait pas être exécuté :
#  - les gestionnaires PHP/CGI sont retirés ;
#  - tout est interdit par défaut, SAUF les noms générés par le serveur
#    (32 caractères hexadécimaux + .webp / .jpg).

Options -Indexes -ExecCGI -Includes

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .phps .cgi .pl .py .sh
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht .phps
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# Interdit tout par défaut…
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# … sauf les images au nom généré par le serveur.
<FilesMatch "^[a-f0-9]{32}(-thumb)?\.(webp|jpg)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Allow from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; sandbox"
</IfModule>
