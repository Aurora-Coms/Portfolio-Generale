# Ce dossier contient le code et la configuration : jamais accessible depuis le web.
# (Protection de secours si le dossier app/ était placé par erreur dans public_html.)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes
